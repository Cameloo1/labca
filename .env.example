APP_NAME=LabCA
ENV=dev
DATABASE_URL=sqlite:///./labca.db
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
API_TOKEN_CREATION_SECRET=
# Directory of KEK files, one file per KEK id, each holding base64 of 32 bytes (prod reads KEKs only from here).
LABCA_KEK_DIR=
# KEK id used to seal new private keys; must match a loaded KEK.
LABCA_ACTIVE_KEK_ID=
# Dev and test only: KEKs may also be given as LABCA_KEK_<ID>=<base64 of 32 bytes>. Prod rejects these.
