APP_NAME=LabCA
ENV=dev
DATABASE_URL=sqlite:///./labca.db
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_VALUE
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
API_TOKEN_CREATION_SECRET=
# Directory of KEK files, one file per KEK id, each holding base64 of 32 bytes (prod reads KEKs only from here).
LABCA_KEK_DIR=
# KEK id used to seal new private keys; must match a loaded KEK.
LABCA_ACTIVE_KEK_ID=
# Dev and test only: KEKs may also be given as LABCA_KEK_<ID>=<base64 of 32 bytes>. Prod rejects these.
# Public origin (scheme and host, no path) used in CRL Distribution Point, AIA and /pki index URLs. Empty means path-only URLs and no CDP or AIA.
PUBLIC_BASE_URL=
# Hours between a CRL thisUpdate and nextUpdate (1 to 720).
CRL_VALIDITY_HOURS=24
# Hours a revoked certificate stays on the CRL after it expires (0 to 8760).
CRL_RETENTION_AFTER_EXPIRY_HOURS=1
# Directory holding root-ca.pem and root-crl.der, served read-only under /pki/root/.
PKI_STATIC_DIR=
# Name of the ACTIVE CA that issues workload certificates and is served under /pki/issuing/.
WORKLOAD_ISSUER_CA_NAME=
# Enable the workload attestation routes under /api/v1/workload (true or false).
WORKLOAD_ISSUANCE_ENABLED=false
# SPIFFE trust domain for workload IDs, for example labca.example.com. Required when workload issuance is enabled.
WORKLOAD_TRUST_DOMAIN=
# Audience that workload ServiceAccount tokens must carry.
WORKLOAD_TOKEN_AUDIENCE=labca
# Comma-separated <namespace>/<serviceaccount> entries allowed to get certificates.
WORKLOAD_ALLOWLIST=
# Workload certificate lifetime in minutes (5 to 1440).
WORKLOAD_CERT_TTL_MINUTES=60
# Sign requests allowed per workload identity per hour (1 to 3600).
WORKLOAD_SIGN_RATE_PER_HOUR=30
# File holding LabCA's own ServiceAccount token, used to call the Kubernetes TokenReview API.
KUBE_SA_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# CA bundle used to verify the Kubernetes API server.
KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# How admin pages authenticate: none (dev only), localhost_only, or cloudflare_access. Prod refuses none.
ADMIN_AUTH_MODE=none
# Cloudflare Access team domain, <team>.cloudflareaccess.com. Required for cloudflare_access.
CF_ACCESS_TEAM_DOMAIN=
# Audience tag of the Cloudflare Access application. Required for cloudflare_access.
CF_ACCESS_AUD=
# Comma-separated emails allowed to use the admin UI. Required for cloudflare_access.
ADMIN_EMAILS=
# Allow admin access from loopback with no forwarding headers when Cloudflare Access is unavailable (true or false).
ADMIN_BREAK_GLASS_LOCALHOST=false
